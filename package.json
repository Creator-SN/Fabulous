{
    "name": "@creatorsn/fabulous",
    "version": "3.10.15",
    "description": "Fabulous Notebook is a WYSIWYG notebook with an exciting paper and literature management system.",
    "main": "./out/main/index.js",
    "author": {
        "name": "Creator-SN",
        "ulr": "https://github.com/Creator-SN"
    },
    "homepage": "https://github.com/Creator-SN/Fabulous",
    "repository": {
        "type": "git",
        "url": "https://github.com/Creator-SN/Fabulous"
    },
    "build": {
        "appId": "com.creatorsn.fabulous",
        "productName": "Fabulous",
        "fileAssociations": [
            {
                "ext": "fbn",
                "name": "Fabulous Notebook File",
                "description": "Fabulous Notebook File",
                "icon": "src/renderer/src/assets/notebook.ico"
            }
        ],
        "directories": {
            "buildResources": "build"
        },
        "win": {
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Fabulous"
        },
        "mac": {
            "icon": "build/icon.icns",
            "entitlements": "build/entitlements.mac.plist",
            "fileAssociations": [
                {
                    "ext": "fbn",
                    "name": "Fabulous Notebook File",
                    "description": "Fabulous Notebook File",
                    "icon": "src/renderer/src/assets/notebook.icns"
                }
            ]
        },
        "publish": [
            {
                "provider": "github",
                "owner": "Creator-SN",
                "repo": "Fabulous"
            }
        ]
    },
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "start": "electron-vite preview",
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "api": "api-cli get https://fb.creatorsn.com/api/v3/api-docs -d ./src/renderer/src/api/remote",
        "api:local": "api-cli get http://100.64.0.10:8000/openapi.json -d ./src/renderer/src/api/remote",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win",
        "build:mac": "npm run build && electron-builder --mac",
        "build:linux": "npm run build && electron-builder --linux",
        "release:stable": "npm version patch",
        "release:beta": "npm version prerelease --preid beta"
    },
    "dependencies": {
        "@creatorsn/powereditor3": "^0.4.7",
        "@creatorsn/vfluent3": "^0.3.89",
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@electron/remote": "^2.1.2",
        "electron-updater": "^6.3.9",
        "axios": "^0.21.4",
        "bibtex-parser": "^0.0.0",
        "cropperjs": "^1.5.13",
        "chokidar": "^4.0.3",
        "diff": "^5.1.0",
        "fs-extra": "^11.3.1",
        "gsap": "^3.13.0",
        "lowdb": "^1.0.0",
        "office-ui-fabric-core": "^11.1.0",
        "onecolor": "^4.1.0",
        "pdfjs-dist": "^4.10.38",
        "pinia": "^2.1.7",
        "vue": "^3.5.17",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config": "^2.0.0",
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "axios-swagger-helper": "^0.0.58",
        "@vitejs/plugin-vue": "^6.0.0",
        "electron": "^37.2.3",
        "electron-builder": "^25.1.8",
        "electron-vite": "^4.0.0",
        "eslint": "^9.31.0",
        "eslint-plugin-vue": "^10.3.0",
        "prettier": "^3.6.2",
        "sass-embedded": "^1.90.0",
        "vite": "^7.0.5",
        "vue-eslint-parser": "^10.2.0"
    }
}
